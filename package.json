{
  "name": "chromium-glossary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "capture:beauty": "tsx scripts/capture-beauty-matrix.ts",
    "capture:diagrams": "tsx scripts/capture-diagram-matrix.ts",
    "refresh:diagram-font-metrics": "tsx scripts/generate-diagram-font-metrics.ts",
    "refresh:evidence": "tsx scripts/refresh-evidence-lock.ts",
    "verify:diagram-font-metrics": "tsx scripts/generate-diagram-font-metrics.ts --check",
    "verify:diagrams": "npm run verify:diagram-font-metrics && tsx scripts/verify-diagram-geometry.ts",
    "verify:glossary": "tsx scripts/verify-glossary.ts",
    "check": "npm run test && npm run lint && npm run verify:glossary && npm run verify:diagrams && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "opentype.js": "^2.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
